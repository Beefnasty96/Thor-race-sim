; Engine configuration file.
config_version=5

[application]

config/name="Racing Sim"
config/description="Realistic racing simulator for the AYN Thor"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
run/main_scene.porter="res://scenes/porter.tscn"
config/name.porter="Car Porter"
config/features=PackedStringArray("4.5", "Mobile")

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
